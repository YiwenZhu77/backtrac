#!/bin/bash
#PBS -N sp13_pilot
#PBS -A YOUR_PROJECT
#PBS -q YOUR_QUEUE
#PBS -l select=1:ncpus=128:mpiprocs=16
#PBS -l walltime=01:00:00
#PBS -o /path/to/pilot-data/sp13_pilot3.out
#PBS -e /path/to/pilot-data/sp13_pilot3.err
#PBS -j oe

module purge
# Load the site-specific compiler, MPI, and HDF5 modules for your installation.

PUSHX=/path/to/kaiju-private/build.backtrac/bin/push.x
cd /path/to/pilot-data

rm -f sp13_pilot.000001.h5part

echo "====== SP13 Pilot Backward Trace ======"
echo "100 H+ from RC at 10:00 UT -> backward to 08:00 UT (2h)"
echo "Fixed dt=0.01s, sp13_075 GAMERA fields"
date

mpiexec -n 16 $PUSHX sp13_backtrace.xml 1 2>&1

echo "STATUS=$?"
date
echo "DONE"
